prefix_rule(
    pattern = ["git", [
        "add",
        "commit",
        "push",
        "pull",
        "fetch",
        "merge",
        "rebase",
        "reset",
        "restore",
        "checkout",
        "switch",
        "stash",
        "branch",
        "tag",
        "rm",
        "mv",
        "clean",
        "cherry-pick",
        "revert",
        "am",
        "apply",
    ]],
    decision = "forbidden",
    # TODO: Explain that repository mutations belong to the human and
    # read-only Git commands remain available.
    justification = "Mutationes Git homini reservantur; mandatis tantum lectivis utere.",
    match = [
        "git add app.js",
        "git commit -m probe",
        "git push origin main",
        "git pull",
        "git fetch origin",
        "git merge topic",
        "git rebase main",
        "git reset --hard HEAD",
        "git restore app.js",
        "git checkout -- app.js",
        "git switch topic",
        "git stash",
        "git branch topic",
        "git tag v1",
        "git rm app.js",
        "git mv app.js app2.js",
        "git clean -fd",
        "git cherry-pick deadbeef",
        "git revert deadbeef",
        "git am patch.mbox",
        "git apply patch.diff",
    ],
    not_match = [
        "git status --short",
        "git diff --check",
        "git log -1",
        "git show HEAD:app.js",
    ],
)
